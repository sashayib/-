{
  "name": "shaddaha-baloot-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "server:dev": "tsx watch server.ts",
    "server:start": "tsx server.ts",
    "server:typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test:phase1": "tsx server/phase1.verify.ts",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "express": "^5.3.0",
    "firebase": "^11.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "latest",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
