# Environment variables (copy to .env locally — never commit real secrets)
FIREBASE_APPCHECK_DEBUG_TOKEN=

# Shaddaha Authoritative Multiplayer Server (Express + WebSocket + Cloud Run)
SERVER_PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
MP_ROOMS_COLLECTION=mp_rooms
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
# Optional JSON service account for local runs; on Cloud Run leave empty to use ADC
FIREBASE_SERVICE_ACCOUNT_JSON=

